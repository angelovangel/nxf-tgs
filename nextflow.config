manifest {
    name            = 'angelovangel/nxf-tgs'
    author          = 'aangeloo@gmail.com'
    homePage        = 'https://github.com/angelovangel/nxf-tgs'
    defaultBranch   = 'main'
    description     = 'Process raw ONT data, generate html report, and do assembly (plasmid, amplicon, bacterial genome)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.2'
    version         = 'v0.5.2'
}

params {
    reads = "fastq_pass"
    samplesheet = "samplesheet.csv" //user, sample, barcode NEEDED
    outdir = "output"
    pipeline = "wf-clone-validation" //can be wf-clone-validation, wf-bacterial-genomes, wf-amplicon, report-only
    assembly_args = null
    assembly_profile = "standard"
    help = ""
    nxf_ver = '24.10.9' //NXF version used for the 'internal' nextflow process
    cpus = 4
    max_memory = null //memory cap for the 'internal' wf-pipeline processes, e.g. 12.GB (set by low_mem profile)
    bakta_time = '2h' //time limit per sample for bakta in wf-bacterial-genomes (normally a few minutes), samples exceeding it are not annotated
}

executor {
    name = 'local'
    cpus = params.cpus
}

profiles {
    standard {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = "$HOME/singularity-cache"
        params.assembly_profile = "singularity" // pass this as --param to the wf-pipeline
        singularity.runOptions = '--bind /dev/shm:/dev/shm'
    }

    test {
        params.reads = "$baseDir/demo/fastq_pass"
        params.samplesheet = "$baseDir/demo/samplesheet.csv"
    }
    lowmem {
        params.max_memory = 12.GB // e.g. flye in wf-bacterial-genomes requests 31 GB by default
    }
}